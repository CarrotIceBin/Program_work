t><view class="popup-spec-values data-v-8ccce192"><block wx:for="{{spec.values}}" wx:for-item="val" wx:for-index="vIdx" wx:key="vIdx"><text data-event-opts="{{[['tap',[['selectSpecValue',['$0','$1'],[[['product.specs','',index,'key']],[['product.specs','',index],['values','',vIdx]]]]]]]}}" class="{{['popup-spec-value','data-v-8ccce192',(selectedSpecs[spec.key]===val)?'active':'']}}" bindtap="__e">{{val}}</text></block></view></view></block></scroll-view><view data-event-opts="{{[['tap',[['confirmSpec',['$event']]]]]}}" class="popup-footer data-v-8ccce192" bindtap="__e">确定</view></view><view class="quantity-row data-v-8ccce192"><text class="quantity-label data-v-8ccce192">购买数量</text><view class="quantity-control data-v-8ccce192"><view data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" class="qty-btn data-v-8ccce192" bindtap="__e">-</view><text class="qty-value data-v-8ccce192">{{qty}}</text><view data-event-opts="{{[['tap',[['e3',['$event']]]]]}}" class="qty-btn data-v-8ccce192" bindtap="__e">+</view></view></view><view data-event-opts="{{[['tap',[['confirmSpec',['$event']]]]]}}" class="popup-footer data-v-8ccce192" bindtap="__e">确定</view></view></block></view>