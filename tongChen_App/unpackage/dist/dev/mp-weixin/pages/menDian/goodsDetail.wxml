<view class="detail-page data-v-8ccce192"><swiper class="image-swiper data-v-8ccce192" indicator-dots="{{true}}" autoplay="{{true}}" circular="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#fff"><block wx:for="{{images}}" wx:for-item="img" wx:for-index="index" wx:key="index"><swiper-item class="data-v-8ccce192"><image class="product-image data-v-8ccce192" src="{{img}}" mode="aspectFill"></image></swiper-item></block></swiper><view class="info-section data-v-8ccce192"><view class="price-row data-v-8ccce192"><text class="price-symbol data-v-8ccce192">¥</text><text class="price-value data-v-8ccce192">{{product.price}}</text><text class="price-unit data-v-8ccce192">起</text><view class="sales-tag data-v-8ccce192">{{"已售 "+product.sales}}</view></view><view class="product-title data-v-8ccce192">{{product.title}}</view><view class="product-desc data-v-8ccce192">{{product.desc}}</view></view><view class="spec-section data-v-8ccce192"><block wx:for="{{product.specs}}" wx:for-item="spec" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selectSpec',[index]]]]]}}" class="spec-item data-v-8ccce192" bindtap="__e"><text class="spec-label data-v-8ccce192">{{spec.label}}</text><view class="spec-values data-v-8ccce192"><block wx:for="{{spec.values}}" wx:for-item="val" wx:for-index="vIdx" wx:key="vIdx"><text data-event-opts="{{[['tap',[['selectSpecValue',['$0','$1'],[[['product.specs','',index,'key']],[['product.specs','',index],['values','',vIdx]]]]]]]}}" class="{{['spec-value','data-v-8ccce192',(selectedSpecs[spec.key]===val)?'active':'']}}" catchtap="__e">{{val}}</text></block></view></view></block></view><view class="detail-section data-v-8ccce192"><view class="section-title data-v-8ccce192">商品详情</view><view class="detail-content data-v-8ccce192"><block wx:for="{{product.details}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="detail-item data-v-8ccce192"><text class="detail-label data-v-8ccce192">{{item.label