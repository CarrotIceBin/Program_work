<view class="store-page data-v-4c941c43"><view class="page-header data-v-4c941c43"><view class="header-title data-v-4c941c43">我的门店</view><block wx:if="{{storeInfo.mdmc}}"><view class="header-subtitle data-v-4c941c43">欢迎回来</view></block><block wx:else><view class="header-subtitle data-v-4c941c43">开启你的商业之旅</view></block></view><block wx:if="{{storeInfo.mdmc}}"><view data-event-opts="{{[['tap',[['viewStoreDetail',['$event']]]]]}}" class="store-card data-v-4c941c43" bindtap="__e"><view class="store-badge data-v-4c941c43">{{storeInfo.menDianFlmc||'门店'}}</view><view class="store-content data-v-4c941c43"><image class="store-image data-v-4c941c43" src="{{storeInfo.iconUrl||'/static/default-store.png'}}" mode="aspectFill"></image><view class="store-info data-v-4c941c43"><view class="store-name data-v-4c941c43">{{storeInfo.mdmc}}</view><view class="store-address data-v-4c941c43">{{"📍 "+storeInfo.address1}}</view><view class="store-meta data-v-4c941c43"><text class="meta-tag data-v-4c941c43">认证商家</text><block wx:if="{{storeInfo.percentSx!=0}}"><text class="meta-tag data-v-4c941c43">{{"服务费 "+storeInfo.percentSx+"%"}}</text></block><text class="{{['meta-status','data-v-4c941c43',storeInfo.statusID==1?'on':'off']}}">{{''+(storeInfo.statusID==1?'● 营业中':'○ 已下架')+''}}</text></view></view></view><view class="store-actions data-v-4c941c43"><view data-event-opts="{{[['tap',[['viewStoreDetail',['$event']]]]]}}" class="action-btn btn-info data-v-4c941c43" catchtap="__e">详情</view><view data-event-opts="{{[['tap',[['editStore',['$event']]]]]}}" class="action-btn btn-edit data-v-4c941c43" catchtap="__e">资料</view><view data-event-opts="{{[['tap',[['toggleStatus',['$event']]]]]}}" class="action-btn btn-status data-v-4c941c43" catchtap="__e">{{''+(storeInfo.statusID==0?"上架":"下架")+''}}</view><view data-event-opts="{{[['tap',[['deleteStore',['$event']]]]]}}" class="action-btn btn-delete data-v-4c941c43" catchtap="__e">删除</view></view></view></block><block wx:else><view class="empty-state data-v-4c941c43"><view class="empty-icon data-v-4c941c43">🏪</view><view class="empty-title data-v-4c941c43">还没有门店</view><view class="empty-desc data-v-4c941c43">添加你的第一个门店，开启商业之旅</view></view></block><view class="ad-section data-v-4c941c43"><view class="section-label data-v-4c941c43">推广工具</view><view class="ad-cards data-v-4c941c43"><view data-event-opts="{{[['tap',[['goNetAd',['$event']]]]]}}" class="ad-card ad-net data-v-4c941c43" bindtap="__e"><view class="ad-icon data-v-4c941c43">📢</view><view class="ad-title data-v-4c941c43">网络广告</view><view class="ad-desc data-v-4c941c43">一键推广到同城</view></view><view data-event-opts="{{[['tap',[['goTempAd',['$event']]]]]}}" class="ad-card ad-temp data-v-4c941c43" bindtap="__e"><view class="ad-icon data-v-4c941c43">⏰</view><view class="ad-title data-v-4c941c43">临时广告</view><view class="ad-desc data-v-4c941c43">限时曝光推广</view></view></view></view><view class="bottom-area data-v-4c941c43"><view data-event-opts="{{[['tap',[['handleStoreAction',['$event']]]]]}}" class="main-btn data-v-4c941c43" bindtap="__e">{{''+(storeInfo.mdmc?'✏️ 编辑门店':'➕ 添加门店')+''}}</view></view></view>