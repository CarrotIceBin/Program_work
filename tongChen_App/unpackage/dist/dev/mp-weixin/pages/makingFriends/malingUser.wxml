ew class="safe-area-bottom"></view></view><block wx:if="{{isRecording}}"><view class="record-mask"><view class="record-box"><view class="record-wave-wrap"><view class="record-circle r1"></view><view class="record-circle r2"></view><view class="record-circle r3"></view><text class="record-mic">🎙</text></view><text class="record-tip">松开发送，上滑取消</text></view></view></block><block wx:if="{{toastText}}"><view class="tab-note"><text>{{toastText}}</text></view></block></view>