.login-container.data-v-2f0f6fbc {
  background: #ffffff;
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
}
/* 背景装饰元素 */
.right-top-sign.data-v-2f0f6fbc {
  position: absolute;
  top: 80rpx;
  right: -30rpx;
  z-index: 1;
  opacity: 0.6;
}
.right-top-sign.data-v-2f0f6fbc:before,
.right-top-sign.data-v-2f0f6fbc:after {
  content: '';
  display: block;
  width: 400rpx;
  height: 80rpx;
  background: #b4f3e2;
}
.right-top-sign.data-v-2f0f6fbc:before {
  -webkit-transform: rotate(50deg);
          transform: rotate(50deg);
  border-radius: 0 50px 0 0;
}
.right-top-sign.data-v-2f0f6fbc:after {
  position: absolute;
  right: -198rpx;
  top: 0;
  -webkit-transform: rotate(-50deg);
          transform: rotate(-50deg);
  border-radius: 50px 0 0 0;
}
/* 头部区域 */
.header.data-v-2f0f6fbc {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 0 20rpx;
}
.back-btn.data-v-2f0f6fbc {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  color: #303133;
}
.back-icon.data-v-2f0f6fbc {
  margin-right: 10rpx;
}
.title.data-v-2f0f6fbc {
  font-size: 40rpx;
}
/* 主要内容区域 */
.main-content.data-v-2f0f6fbc {
  margin: 0 40rpx;
  position: relative;
  z-index: 5;
  text-align: center;
}
.logo-text.data-v-2f0f6fbc {
  font-size: 120rpx;
  color: #f8f8f8;
  font-weight: 800;
  text-align: center;
  margin-bottom: 100rpx;
  letter-spacing: 8rpx;
}
/* 按钮样式优化 */
.quick-login-btn.data-v-2f0f6fbc {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  background: #00c375;
  border: none;
  margin: 0 auto;
}
.quick-login-btn[disabled].data-v-2f0f6fbc {
  background: #c0c4cc;
  -webkit-transform: none;
          transform: none;
}
/* 其他登录方式 */
.other-login-section.data-v-2f0f6fbc {
  margin-top: 60rpx;
  text-align: center;
}
.other-login-title.data-v-2f0f6fbc {
  display: block;
  font-size: 28rpx;
  color: #909399;
  margin-bottom: 30rpx;
}
.other-login-icons.data-v-2f0f6fbc {
  display: flex;
  justify-content: center;
  gap: 60rpx;
}
.login-icon.data-v-2f0f6fbc {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.icon-img.data-v-2f0f6fbc {
  width: 70rpx;
  height: 70rpx;
  margin-bottom: 10rpx;
}
.icon-text.data-v-2f0f6fbc {
  font-size: 24rpx;
  color: #606266;
}
/* 用户协议区域优化 */
.agreement-section.data-v-2f0f6fbc {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  color: #666;
  font-size: 28rpx;
  text-align: left;
}
.agreement-checkbox.data-v-2f0f6fbc {
  margin-right: 10rpx;
}
.agreement-text.data-v-2f0f6fbc {
  font-size: 28rpx;
  color: #666;
  flex: 1;
  line-height: 1.5;
}
.agreement-link.data-v-2f0f6fbc {
  color: #FD7031;
  font-size: 28rpx;
}
.login-container .uni-popup.data-v-2f0f6fbc .uni-popup__wrapper {
  margin: 0 20px;
  border-radius: 8px;
}
.login-container .uni-popup .share-popup.data-v-2f0f6fbc {
  padding: 20px;
  background: #fff;
  border-radius: 8px;
  width: 370px;
}
.login-container .uni-popup .share-popup .share-title.data-v-2f0f6fbc {
  text-align: center;
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 10px;
}
.login-container .uni-popup .share-popup .popup_index.data-v-2f0f6fbc {
  height: 80rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}
.login-container .uni-popup .share-popup .button-group.data-v-2f0f6fbc {
  display: flex;
  gap: 10px;
  justify-content: center;
  align-items: center;
  margin-top: 16px;
}
.login-container .uni-popup .share-popup .button-group .agree-btn.data-v-2f0f6fbc {
  color: #ffffff;
  background: #FD7031;
}
.login-container .uni-popup .share-popup .button-group .disagree-btn.data-v-2f0f6fbc {
  background: #f5f5f5;
  color: #666;
}
.login-container .uni-popup .share-popup .button-group .disagre-agree.data-v-2f0f6fbc {
  font-size: 15px;
  width: 50%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 44px;
  border-radius: 5px;
}

