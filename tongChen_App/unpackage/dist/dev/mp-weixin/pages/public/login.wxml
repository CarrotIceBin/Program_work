<view class="login-container data-v-2f0f6fbc"><view class="left-bottom-sign data-v-2f0f6fbc"></view><view class="right-top-sign data-v-2f0f6fbc"></view><view data-event-opts="{{[['tap',[['handleBack',['$event']]]]]}}" class="header data-v-2f0f6fbc" style="{{(headerStyle)}}" bindtap="__e"><view class="back-btn data-v-2f0f6fbc"><uni-icons class="back-icon data-v-2f0f6fbc" vue-id="9a41ee6c-1" type="back" size="24" bind:__l="__l"></uni-icons><text class="title data-v-2f0f6fbc">登录</text></view></view><view class="main-content data-v-2f0f6fbc" style="{{(mainContentStyle)}}"><view class="logo-text data-v-2f0f6fbc"></view><view class="agreement-section data-v-2f0f6fbc"><label class="agreement-checkbox data-v-2f0f6fbc"><checkbox-group data-event-opts="{{[['change',[['handleAgreementChange',['$event']]]]]}}" bindchange="__e" class="data-v-2f0f6fbc"><checkbox value="1" checked="{{isAgreed}}" color="#FD7031" class="data-v-2f0f6fbc"></checkbox></checkbox-group></label><view class="agreement-text data-v-2f0f6fbc"> 阅读并同意 <text data-event-opts="{{[['tap',[['openWebPage',['yongHuXieYi']]]]]}}" class="agreement-link data-v-2f0f6fbc" bindtap="__e">《用户协议》</text><text data-event-opts="{{[['tap',[['openWebPage',['yinSiXieYi']]]]]}}" class="agreement-link data-v-2f0f6fbc" bindtap="__e">《隐私政策》</text></view></view><button class="quick-login-btn data-v-2f0f6fbc" open-type="getPhoneNumber" data-event-opts="{{[['tap',[['handlePhoneNumberAuth',['$event']]]]]}}" bindtap="__e">微信登录</button><view class="other-login-section data-v-2f0f6fbc"><text class="other-login-title data-v-2f0f6fbc">其他登录方式</text><view class="other-login-icons data-v-2f0f6fbc"><block wx:for="{{loginMethodData}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block class="data-v-2f0f6fbc"><view data-event-opts="{{[['tap',[['switchLoginMethod',['$0'],[[['loginMethodData','',index,'methodID']]]]]]]}}" class="login-icon data-v-2f0f6fbc" bindtap="__e"><image class="icon-img data-v-2f0f6fbc" src="{{item.image}}" mode="widthF