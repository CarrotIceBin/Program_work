.wallet-page.data-v-3b16d854 {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx;
  box-sizing: border-box;
}
/* 资产卡片 */
.asset-card.data-v-3b16d854 {
  background: linear-gradient(135deg, #ff9a44 0%, #fc6076 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(252, 96, 118, 0.2);
}
.asset-title.data-v-3b16d854 {
  font-size: 28rpx;
  opacity: 0.9;
}
.asset-balance.data-v-3b16d854 {
  font-size: 72rpx;
  font-weight: bold;
  margin: 16rpx 0;
}
.asset-tags.data-v-3b16d854 {
  display: flex;
  gap: 16rpx;
}
.asset-tag.data-v-3b16d854 {
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}
/* 资产明细 */
.asset-detail.data-v-3b16d854 {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
}
.detail-item.data-v-3b16d854 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.detail-item.data-v-3b16d854:last-child {
  border-bottom: none;
}
.detail-label.data-v-3b16d854 {
  font-size: 28rpx;
  color: #666;
}
.detail-value.data-v-3b16d854 {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}
.detail-value.income.data-v-3b16d854 {
  color: #52c41a;
}
.detail-value.cost.data-v-3b16d854 {
  color: #ff4d4f;
}
/* 操作按钮 */
.action-section.data-v-3b16d854 {
  display: flex;
  justify-content: space-around;
  background: #fff;
  margin-top: 24rpx;
  padding: 32rpx 0;
  border-radius: 20rpx;
}
.action-btn.data-v-3b16d854 {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #333;
}
.action-icon.data-v-3b16d854 {
  font-size: 56rpx;
}
/* 提示 */
.tips.data-v-3b16d854 {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}
.tips-title.data-v-3b16d854 {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 16rpx;
  font-weight: 500;
}
.tips-item.data-v-3b16d854 {
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}

